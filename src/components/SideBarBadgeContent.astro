---
import Badge from "./Badge.astro";

interface Props {
  title: string;
  items: string[];
  core?: string[];
}

const { title, items, core = [] } = Astro.props;
const coreSet = new Set(core);
---

<div>
  <h2 class="font-display text-sm font-semibold tracking-tight text-muted-foreground mb-2">{title}</h2>
  <div class="flex flex-wrap gap-1.5">
    {items.map((item) => <Badge prominent={coreSet.has(item)}>{item}</Badge>)}
  </div>
</div>
