---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  role: CollectionEntry<"work">;
  showPeriod: boolean;
}

const { role, showPeriod } = Astro.props;
const { Content } = await render(role);
---

<article class="py-6 first:pt-0 last:pb-0">
  <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h4 class="text-[0.9375rem] font-semibold leading-snug text-foreground">
      {role.data.title}
    </h4>
    {
      showPeriod && (
        <p class="ml-auto shrink-0 text-right text-xs text-muted-foreground tabular-nums">
          {role.data.employmentPeriod}
        </p>
      )
    }
  </header>
  <div
    class="mt-3 text-sm leading-relaxed text-muted-foreground [&_ul]:space-y-2.5 [&_li]:relative [&_li]:pl-4 [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[0.7em] [&_li]:before:size-1 [&_li]:before:rounded-full [&_li]:before:bg-muted-foreground/60"
  >
    <Content />
  </div>
</article>
