---
interface Props {
  prominent?: boolean;
}

const { prominent = false } = Astro.props;

const base = "inline-flex items-center rounded border border-border px-2 py-1 text-xs text-foreground";
const tier = prominent ? "bg-chip-core font-medium" : "bg-transparent font-normal";
---

<span class:list={[base, tier]}>
  <slot />
</span>
