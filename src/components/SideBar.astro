---
import { Image } from "astro:assets";
import { MapPin, Download } from "@lucide/astro";
import { Button } from "@/components/ui/button";
import { EmailButton } from "@/components/EmailButton";
import { ModeToggle } from "@/components/ModeToggle";
import { CursorFollowerSprite } from "@/components/CursorFollowerSprite";
import SideBarContent from "@/layouts/SideBarContentLayout.astro";
import SideBarBadgeContent from "@/components/SideBarBadgeContent.astro";

// Assets
import githubLogo from "@/assets/github.svg";
import linkedInLogo from "@/assets/linkedIn.svg";
import portraitImg from "@/assets/portrait.png";
import walkingSpriteSheet from "@/assets/walking_sheet_transparent.png";

const coreStack = ["C#", "TypeScript", ".NET", "Node", "React", "Next.js", "Azure", "Cosmos DB"];

const languages = ["C#", "TypeScript", "Python", "Ruby"];
const frameworks = [".NET", "Node", "React", "Next.js", "React Native", "Rails", "Astro", "Django", "Angular",];
const backendCloud = ["Azure", "AWS", "Cloudflare Workers", "Firebase"];
const databases = ["Cosmos DB", "Postgres", "SQL Server", "MongoDB"];
const devopsTools = ["Azure DevOps", "Github Actions", "Docker", "Terraform"];
---

<div class="py-6 md:pr-8 md:sticky md:top-0 md:self-start">
  <div>
    <div class="flex flex-col items-center text-center mb-4">
      <div
        class="w-24 h-24 bg-secondary rounded-full flex items-center justify-center mb-3 overflow-hidden ring-1 ring-border"
      >
        <Image
          src={portraitImg}
          width={96}
          height={96}
          alt="Kevin Dang"
          class="w-full h-full object-cover object-top"
          loading="eager"
        />
      </div>
      <h1
        class="font-display text-[clamp(2.25rem,1.6rem+2.8vw,3rem)] font-bold leading-[1.05] tracking-[-0.02em] text-foreground"
      >
        Kevin Dang
      </h1>
      <p class="text-muted-foreground">Senior Software Engineer</p>
      <div class="flex items-center text-sm text-muted-foreground mt-2">
        <MapPin size={14} class="mr-1" />
        <span>Toronto, Canada</span>
      </div>
    </div>

    <div class="flex justify-center gap-2 mb-4">
      <a target="_blank" href="https://github.com/k-dang" aria-label="Github">
        <Button variant="outline" size="icon">
          <Image
            class="invert dark:invert-0"
            src={githubLogo}
            width="16"
            height="16"
            alt="Github"
            loading="eager"
          />
        </Button>
      </a>

      <a target="_blank" href="https://www.linkedin.com/in/kdang1/" aria-label="LinkedIn">
        <Button variant="outline" size="icon">
          <Image
            class="dark:invert invert-0"
            src={linkedInLogo}
            width="16"
            height="16"
            alt="LinkedIn"
            loading="eager"
          />
        </Button>
      </a>

      <EmailButton client:idle email="dangkevin12@gmail.com" />
      <a href="/kevin-dang-cv.pdf" download>
        <Button variant="accent" size="default">
          <Download />
          <span class="text-sm">Resume</span>
        </Button>
      </a>
    </div>

    <div class="flex justify-center gap-2 border-t border-border pt-4 mb-5">
      <ModeToggle client:load />
      <CursorFollowerSprite
        client:load
        spriteSrc={walkingSpriteSheet.src}
        frameWidth={256}
        frameHeight={256}
        frameCount={4}
        fps={6}
        scale={0.28}
        offsetX={10}
        offsetY={10}
      />
    </div>

    <div class="space-y-5">
      <SideBarContent title="Education">
        <div class="text-sm">
          <p class="text-foreground font-medium">McMaster University</p>
          <p class="text-muted-foreground">B.Eng Mechatronics Engineering</p>
        </div>
      </SideBarContent>
      <div class="space-y-3">
        <SideBarBadgeContent title="Languages" items={languages} core={coreStack} />
        <SideBarBadgeContent title="Frameworks" items={frameworks} core={coreStack} />
        <SideBarBadgeContent title="Cloud" items={backendCloud} core={coreStack} />
        <SideBarBadgeContent title="Databases" items={databases} core={coreStack} />
        <SideBarBadgeContent title="DevOps & Tools" items={devopsTools} core={coreStack} />
      </div>
    </div>
  </div>
</div>
