---
import type { CollectionEntry } from "astro:content";

import WorkRole from "@/components/WorkRole.astro";

interface Props {
  employer: string;
  roles: CollectionEntry<"work">[];
}

const { employer, roles } = Astro.props;

// roles are newest-first, so the tenure spans the oldest start to the newest end
const [start] = roles[roles.length - 1].data.employmentPeriod.split(" - ");
const [, end] = roles[0].data.employmentPeriod.split(" - ");
---

<div class="relative border-l border-border pl-6 pb-8 last:pb-0">
  <span
    class="absolute -left-[4.5px] top-1.5 size-2 rounded-full bg-muted-foreground ring-4 ring-background"
    aria-hidden="true"
  >
  </span>
  <div class="max-w-[68ch] text-sm">
    <div class="flex flex-wrap items-baseline gap-x-4">
      <h3 class="font-display text-base font-semibold tracking-tight text-foreground">
        {employer}
      </h3>
      <p class="ml-auto shrink-0 text-right text-xs text-muted-foreground tabular-nums">
        {start} - {end}
      </p>
    </div>
    <div class="mt-3 space-y-5">
      {roles.map((role) => <WorkRole role={role} showPeriod={roles.length > 1} />)}
    </div>
  </div>
</div>
