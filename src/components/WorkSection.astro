---
import type { CollectionEntry } from "astro:content";

import WorkRole from "@/components/WorkRole.astro";

interface Props {
  employer: string;
  roles: CollectionEntry<"work">[];
}

const { employer, roles } = Astro.props;

// roles are newest-first, so the tenure spans the oldest start to the newest end
const [start] = roles[roles.length - 1].data.employmentPeriod.split(" - ");
const [, end] = roles[0].data.employmentPeriod.split(" - ");
---

<section
  class="grid gap-5 border-t border-border py-8 first:border-t-0 first:pt-0 last:pb-0 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-8"
>
  <header>
    <h3 class="font-display text-lg font-semibold tracking-tight text-foreground">{employer}</h3>
    <p class="mt-1 text-xs leading-5 text-muted-foreground tabular-nums">
      {start} - {end}
    </p>
  </header>

  <div class="min-w-0 max-w-[56ch] divide-y divide-border/70">
    {roles.map((role) => <WorkRole role={role} showPeriod={roles.length > 1} />)}
  </div>
</section>
