---
import { render, type CollectionEntry } from "astro:content";
interface Props {
  work: CollectionEntry<"work">;
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<div class="relative border-l border-border pl-6 pb-8 last:pb-0">
  <span
    class="absolute -left-[4.5px] top-1.5 size-2 rounded-full bg-muted-foreground ring-4 ring-background"
    aria-hidden="true"
  >
  </span>
  <div>
    <h3 class="font-semibold text-foreground">
      {work.data.title}
    </h3>
    <p class="text-sm font-medium text-foreground">
      {work.data.employer}
    </p>
    <p class="mt-0.5 text-xs text-muted-foreground">
      {work.data.employmentPeriod}
    </p>
  </div>
  <div class="mt-2 space-y-2 text-muted-foreground text-sm leading-relaxed max-w-[68ch]">
    <Content />
  </div>
</div>
