---
import { Image } from "astro:assets";

import { MapPin } from "@lucide/astro";

import SidebarActions from "@/components/sidebar/SidebarActions.astro";
import { isCoreSkill, skillGroups } from "@/components/sidebar/sidebarData";

import portraitImg from "@/assets/portrait.png";
---

<section aria-labelledby="sidebar-name">
  <header class="text-center">
    <Image
      src={portraitImg}
      width={80}
      height={80}
      alt="Kevin Dang"
      class="mx-auto size-20 rounded-full object-cover object-top ring-1 ring-border"
      loading="eager"
    />
    <h1
      id="sidebar-name"
      class="mt-3 font-display text-[2.25rem] font-bold leading-none tracking-[-0.025em]"
    >
      Kevin Dang
    </h1>
    <p class="mt-2 text-sm text-muted-foreground">Senior Software Engineer</p>
    <p class="mt-1 flex items-center justify-center gap-1 text-xs text-muted-foreground">
      <MapPin size={12} />
      Toronto, Canada
    </p>
  </header>

  <div class="mt-5 md:mt-4">
    <SidebarActions />
  </div>

  <section class="mt-7 md:mt-6" aria-labelledby="sidebar-capabilities">
    <div class="flex items-end justify-between border-b border-border pb-2">
      <h2 id="sidebar-capabilities" class="font-display text-sm font-semibold text-foreground">
        Capabilities
      </h2>
      <p class="text-[0.6875rem] text-muted-foreground">Core skills in bold</p>
    </div>
    <dl>
      {
        skillGroups.map((group) => (
          <div class="grid grid-cols-[5.75rem_1fr] gap-3 border-b border-border py-3">
            <dt class="font-display text-xs font-semibold text-muted-foreground">{group.label}</dt>
            <dd class="text-xs leading-5 text-muted-foreground">
              {group.items.map((skill, index) => (
                <>
                  <span class:list={[isCoreSkill(skill) && "font-semibold text-foreground"]}>
                    {skill}
                  </span>
                  {index < group.items.length - 1 && <span aria-hidden="true">, </span>}
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <p class="mt-5 text-xs leading-5 text-muted-foreground">
    <span class="font-medium text-foreground">McMaster University</span><br />
    B.Eng Mechatronics Engineering
  </p>
</section>
