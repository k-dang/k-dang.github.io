---
import { CursorFollowerSprite } from "@/components/CursorFollowerSprite";
import { ModeToggle } from "@/components/ModeToggle";

import walkingSpriteSheet from "@/assets/walking_sheet_transparent.png";
---

<div class="mt-5 flex items-center justify-between border-t border-border pt-4 md:mt-4">
  <div>
    <p class="font-display text-sm font-semibold text-foreground">Display</p>
    <p class="text-xs text-muted-foreground">Theme and character</p>
  </div>
  <div class="flex gap-2">
    <ModeToggle client:load />
    <CursorFollowerSprite
      client:load
      spriteSrc={walkingSpriteSheet.src}
      frameWidth={256}
      frameHeight={256}
      frameCount={4}
      fps={6}
      scale={0.28}
      offsetX={10}
      offsetY={10}
    />
  </div>
</div>
