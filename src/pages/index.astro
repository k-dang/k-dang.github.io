---
import { getCollection } from "astro:content";

import { ArrowUpRight } from "@lucide/astro";

import Layout from "@/layouts/Layout.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import WorkSection from "@/components/WorkSection.astro";
import ProjectCard from "@/components/ProjectCard.astro";

import * as about from "@/data/about.md";
import SideBar from "@/components/SideBar.astro";

const workEntries = await getCollection("work");
const sortedWorkEntries = workEntries.sort((a, b) => {
  return a.data.order - b.data.order;
});

// consecutive roles at the same employer collapse into one tenure block
const workGroups: { employer: string; roles: typeof sortedWorkEntries }[] = [];
for (const work of sortedWorkEntries) {
  const current = workGroups.at(-1);
  if (current?.employer === work.data.employer) current.roles.push(work);
  else workGroups.push({ employer: work.data.employer, roles: [work] });
}

const projects = await getCollection("projects");
const sortedProjects = projects
  .filter((project) => !project.data.hide)
  .sort((a, b) => {
    return a.data.order - b.data.order;
  });
---

<Layout>
  <div
    class="mx-auto max-w-5xl px-5 md:px-8 md:grid md:grid-cols-[300px_1fr] lg:grid-cols-[320px_1fr] md:items-start"
  >
    <SideBar />
    <div
      class="min-w-0 border-t border-border md:border-t-0 md:border-l md:border-border md:pl-8 lg:pl-12"
    >
      <main>
        <div class="divide-y divide-border">
          <ContentLayout title={about.frontmatter.title} index={1}>
            <div class="about-copy grid max-w-[68ch] gap-x-8 gap-y-5 sm:grid-cols-2">
              <about.Content />
            </div>
          </ContentLayout>
          <ContentLayout title="Work Experience" index={2}>
            {workGroups.map((group) => <WorkSection {...group} />)}
          </ContentLayout>
          <ContentLayout title="Projects" index={3}>
            <div class="flex flex-col gap-2">
              {sortedProjects.map((project) => <ProjectCard project={project} />)}
            </div>
          </ContentLayout>
        </div>
      </main>

      <footer>
        <div
          class="mt-8 flex flex-col gap-4 border-t border-border py-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="text-sm text-muted-foreground">© 2026 Kevin Dang · Toronto, Canada</p>
          <a
            href="mailto:dangkevin12@gmail.com"
            class="inline-flex items-center gap-1 text-sm font-medium text-foreground transition-colors hover:text-accent-violet"
          >
            Get in touch
            <ArrowUpRight size={15} class="text-muted-foreground" />
          </a>
        </div>
      </footer>
    </div>
  </div>
</Layout>
